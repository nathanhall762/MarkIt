
---
import '../index.css';

const brandColors = [
  { name: 'Primary', token: '--brand-primary' },
  { name: 'Secondary', token: '--brand-secondary' },
  { name: 'Accent', token: '--brand-accent' },
];

const neutralColors = [
  { name: 'Neutral dark', token: '--neutral-dark' },
  { name: 'Neutral light', token: '--neutral-light' },
];

const surfaceColors = [
  { name: 'Page background', token: '--page-background' },
  { name: 'Surface', token: '--surface-background' },
  { name: 'Subtle surface', token: '--surface-subtle' },
  { name: 'Brand surface', token: '--surface-brand' },
  { name: 'Selected surface', token: '--surface-selected' },
  { name: 'Secondary surface', token: '--surface-secondary' },
];

const textColors = [
  { name: 'Primary text', token: '--text-primary' },
  { name: 'Secondary text', token: '--text-secondary' },
  { name: 'Disabled text', token: '--text-disabled' },
];

const actionColors = [
  { name: 'Primary action', token: '--action-primary' },
  { name: 'Primary action hover', token: '--action-primary-hover' },
  { name: 'Text on primary action', token: '--on-action-primary' },
];

const statusColors = [
  {
    name: 'Success',
    token: '--status-success',
    background: '--success-background',
  },
  {
    name: 'Warning',
    token: '--status-warning',
    background: '--warning-background',
  },
  {
    name: 'Danger',
    token: '--status-danger',
    background: '--danger-background',
  },
];

const borderColors = [
  { name: 'Border', token: '--border-color' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>MarkIt — Color System</title>
  </head>
  <body>
    <main class="color-page">
      <header class="page-header">
        <p class="eyebrow">MARKIT DESIGN SYSTEM</p>
        <h1>Color palette</h1>
        <p class="intro">
          Brand primitives, semantic color roles, and theme-specific surfaces.
          Values are resolved from the CSS custom properties in index.css.
        </p>
      </header>

      <section class="section">
        <h2>Brand colors</h2>
        <p class="section-description">
          Brand identity colors remain consistent between themes.
        </p>
        <div class="swatch-grid">
          {brandColors.map((color) => (
            <div class="swatch-card" data-token={color.token}>
              <div
                class="swatch"
                style={`background-color: var(${color.token})`}
              ></div>
              <div class="swatch-info">
                <h3>{color.name}</h3>
                <code>{color.token}</code>
                <p class="resolved-value">Resolving…</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="section">
        <h2>Neutral primitives</h2>
        <div class="swatch-grid">
          {neutralColors.map((color) => (
            <div class="swatch-card" data-token={color.token}>
              <div
                class="swatch"
                style={`background-color: var(${color.token})`}
              ></div>
              <div class="swatch-info">
                <h3>{color.name}</h3>
                <code>{color.token}</code>
                <p class="resolved-value">Resolving…</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="section">
        <h2>Theme comparison</h2>
        <p class="section-description">
          These previews use the same semantic tokens, resolved under each
          theme's variables.
        </p>

        <div class="theme-grid">
          {['light', 'dark'].map((theme) => (
            <div class={`theme-preview ${theme}`} data-theme={theme}>
              <div class="preview-header">
                <div>
                  <p class="eyebrow">THEME</p>
                  <h3>{theme === 'light' ? 'Light mode' : 'Dark mode'}</h3>
                </div>
                <span class="theme-indicator">
                  {theme === 'light' ? '☀' : '☾'}
                </span>
              </div>

              <div class="preview-content">
                <div class="sample-panel">
                  <p class="sample-label">Page background</p>
                  <div class="sample-surface page-surface">
                    <span>Page</span>
                    <code data-value="--page-background">Resolving…</code>
                  </div>
                </div>

                <div class="sample-panel">
                  <p class="sample-label">Surface hierarchy</p>
                  <div class="surface-stack">
                    <div class="sample-surface base-surface">
                      <span>Surface</span>
                      <code data-value="--surface-background">Resolving…</code>
                    </div>
                    <div class="sample-surface subtle-surface">
                      <span>Subtle</span>
                      <code data-value="--surface-subtle">Resolving…</code>
                    </div>
                    <div class="sample-surface brand-surface">
                      <span>Brand tint</span>
                      <code data-value="--surface-brand">Resolving…</code>
                    </div>
                    <div class="sample-surface selected-surface">
                      <span>Selected</span>
                      <code data-value="--surface-selected">Resolving…</code>
                    </div>
                    <div class="sample-surface secondary-surface">
                      <span>Secondary tint</span>
                      <code data-value="--surface-secondary">Resolving…</code>
                    </div>
                  </div>
                </div>

                <div class="sample-panel">
                  <p class="sample-label">Text hierarchy</p>
                  <div class="text-samples">
                    <p class="primary-text">Primary text</p>
                    <p class="secondary-text">Secondary text</p>
                    <p class="disabled-text">Disabled text</p>
                  </div>
                </div>

                <div class="sample-panel">
                  <p class="sample-label">Actions</p>
                  <div class="button-samples">
                    <button type="button" class="primary-button">
                      Primary action
                    </button>
                    <button type="button" class="hover-button">
                      Hover state
                    </button>
                  </div>
                  <div class="value-list">
                    {actionColors.map((color) => (
                      <div class="value-row" data-token={color.token}>
                        <span>{color.name}</span>
                        <code class="resolved-value">Resolving…</code>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="sample-panel">
                  <p class="sample-label">Status colors</p>
                  <div class="status-stack">
                    {statusColors.map((color) => (
                      <div
                        class="status-sample"
                        style={`--status-foreground: var(${color.token}); --status-fill: var(${color.background})`}
                      >
                        <span>{color.name}</span>
                        <code data-value={color.token}>Resolving…</code>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="sample-panel">
                  <p class="sample-label">Borders and controls</p>
                  <div class="control-sample">
                    <label>
                      Example input
                      <input type="text" value="Sample value" readonly />
                    </label>
                    <div class="border-example">
                      Border color
                      <code data-value="--border-color">Resolving…</code>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="section">
        <h2>Status primitives</h2>
        <div class="swatch-grid">
          {statusColors.map((color) => (
            <div class="swatch-card" data-token={color.token}>
              <div
                class="swatch"
                style={`background-color: var(${color.token})`}
              ></div>
              <div class="swatch-info">
                <h3>{color.name}</h3>
                <code>{color.token}</code>
                <p class="resolved-value">Resolving…</p>
                <div
                  class="status-background-chip"
                  style={`background-color: var(${color.background})`}
                >
                  Background: {color.background}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="section">
        <h2>Border</h2>
        <div class="swatch-grid">
          {borderColors.map((color) => (
            <div class="swatch-card" data-token={color.token}>
              <div
                class="swatch"
                style={`background-color: var(${color.token})`}
              ></div>
              <div class="swatch-info">
                <h3>{color.name}</h3>
                <code>{color.token}</code>
                <p class="resolved-value">Resolving…</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <footer class="page-footer">
        <p>
          This page is a development reference. Update the design tokens in
          <code>src/index.css</code> to change the palette.
        </p>
      </footer>
    </main>

    <script>
      function resolveColorValues(root: HTMLElement) {
        const styles = getComputedStyle(root);

        root.querySelectorAll<HTMLElement>('[data-token]').forEach((card) => {
          const token = card.dataset.token;
          const output = card.querySelector<HTMLElement>('.resolved-value');

          if (!token || !output) return;

          const value = styles.getPropertyValue(token).trim();
          output.textContent = value || 'Token not defined';
        });

        root.querySelectorAll<HTMLElement>('[data-value]').forEach((element) => {
          const token = element.dataset.value;

          if (!token) return;

          const value = styles.getPropertyValue(token).trim();
          element.textContent = value || 'Token not defined';
        });
      }

      document.querySelectorAll<HTMLElement>('.color-page, .theme-preview').forEach(
        (root) => resolveColorValues(root),
      );
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
  }

  .color-page {
    min-height: 100vh;
    padding: 48px 24px 64px;
    background: var(--page-background);
    color: var(--text-primary);
    font-family: Calibre, sans-serif;
  }

  .page-header,
  .section,
  .page-footer {
    width: min(100%, 1200px);
    margin-inline: auto;
  }

  .page-header {
    margin-bottom: 48px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--brand-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 12px;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .intro,
  .section-description {
    max-width: 680px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .section {
    margin-bottom: 52px;
  }

  .section h2 {
    margin-bottom: 8px;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .section-description {
    margin-bottom: 20px;
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }

  .swatch-card {
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--surface-background);
  }

  .swatch {
    height: 112px;
    border-bottom: 1px solid var(--border-color);
  }

  .swatch-info {
    padding: 16px;
  }

  .swatch-info h3 {
    margin-bottom: 6px;
    font-size: 1rem;
    font-weight: 600;
  }

  code {
    overflow-wrap: anywhere;
    font-family: Menlo, Monaco, monospace;
    font-size: 0.75rem;
  }

  .swatch-info > code {
    color: var(--text-secondary);
  }

  .resolved-value {
    margin: 8px 0 0;
    color: var(--text-secondary);
    font-family: Menlo, Monaco, monospace;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 20px;
  }

  .theme-preview {
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--page-background);
    color: var(--text-primary);
  }

  .theme-preview.light {
    color-scheme: light;
  }

  .theme-preview.dark {
    color-scheme: dark;
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .preview-header .eyebrow {
    margin-bottom: 4px;
  }

  .preview-header h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  .theme-indicator {
    font-size: 1.5rem;
  }

  .preview-content {
    display: grid;
    gap: 24px;
  }

  .sample-panel {
    min-width: 0;
  }

  .sample-label {
    margin-bottom: 10px;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sample-surface {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface-background);
    color: var(--text-primary);
  }

  .sample-surface code {
    color: var(--text-secondary);
  }

  .page-surface {
    background: var(--page-background);
  }

  .base-surface {
    background: var(--surface-background);
  }

  .subtle-surface {
    background: var(--surface-subtle);
  }

  .brand-surface {
    background: var(--surface-brand);
  }

  .selected-surface {
    background: var(--surface-selected);
  }

  .secondary-surface {
    background: var(--surface-secondary);
  }

  .surface-stack {
    display: grid;
    gap: 8px;
  }

  .text-samples {
    padding: 16px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface-background);
  }

  .text-samples p {
    margin-bottom: 12px;
  }

  .text-samples p:last-child {
    margin-bottom: 0;
  }

  .primary-text {
    color: var(--text-primary);
  }

  .secondary-text {
    color: var(--text-secondary);
  }

  .disabled-text {
    color: var(--text-disabled);
  }

  .button-samples {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }

  .button-samples button {
    padding: 10px 14px;
    border: 0;
    border-radius: 8px;
    background: var(--action-primary);
    color: var(--on-action-primary);
    font: inherit;
    cursor: default;
  }

  .button-samples .hover-button {
    background: var(--action-primary-hover);
  }

  .value-list {
    display: grid;
    gap: 8px;
  }

  .value-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.875rem;
  }

  .value-row .resolved-value {
    margin: 0;
    text-align: right;
  }

  .status-stack {
    display: grid;
    gap: 8px;
  }

  .status-sample {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px;
    border-radius: 8px;
    background: var(--status-fill);
    color: var(--status-foreground);
  }

  .status-sample code {
    color: inherit;
  }

  .control-sample {
    display: grid;
    gap: 16px;
  }

  .control-sample label {
    display: grid;
    gap: 8px;
    font-size: 0.875rem;
  }

  .control-sample input {
    width: 100%;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface-background);
    color: var(--text-primary);
    font: inherit;
  }

  .border-example {
    display: grid;
    gap: 10px;
    padding: 12px;
    border: 2px solid var(--border-color);
    border-radius: 8px;
  }

  .status-background-chip {
    margin-top: 12px;
    padding: 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .page-footer {
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .color-page {
      padding: 32px 16px 48px;
    }

    .theme-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .theme-preview {
      padding: 18px;
    }
  }
</style>
