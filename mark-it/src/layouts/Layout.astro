---
import "../index.css";
import Header from "../components/Header";

interface Props {
  title: string;
  metaDescription: string;
}

const { title, metaDescription } = Astro.props;

const websiteName = "MarkItStorage";
const navs = [{ link: "/shop", name: "Shop" }];
const cta = "Start Marking!";
---

<!doctype html>
<html lang="en" class="bg-black font-sans font-light text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <title>{title ? `${title} - ${websiteName}` : websiteName}</title>
  </head>
  <body class="bg-ltbg2 dark:bg-dkbg2">
    <Header
      title={websiteName}
      navs={navs.filter((nav) => nav.link !== "/")}
      cta={cta}
      client:load
    />
    <slot />
  </body>

</html>
